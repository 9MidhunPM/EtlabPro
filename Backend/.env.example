# EtlabPro - Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.

# -- Supabase ----------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -- API Security ------------------------------------------------------
# Shared secret sent by frontend in X-API-Key header on every request.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=replace_with_your_generated_key

# Comma-separated allowed frontend origins (no trailing slash).
FRONTEND_ORIGINS=http://localhost:3000

# Set to development locally to expose /docs and /redoc.
ENV=production

# -- Etlab credentials (required for etlab_sync_scraper.py) -----------
ETLAB_USERNAME=your_college_username
ETLAB_PASSWORD=your_college_password

# Force a full re-sync ignoring staleness intervals (true/false).
# ETLAB_FORCE_SYNC=false

# -- Refresh policy overrides (optional) ------------------------------
# ATTENDANCE_MAX_AGE_SECONDS=7200
# MARKS_MAX_AGE_SECONDS=604800
# TIMETABLE_MAX_AGE_SECONDS=604800
# PROFILE_MAX_AGE_SECONDS=604800
# UNI_RESULTS_MAX_AGE_SECONDS=604800
# REQUEST_TIMEOUT=90